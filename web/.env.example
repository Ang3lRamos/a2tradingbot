# Copia este archivo como .env.local (y pon los mismos valores en Vercel > Settings > Environment Variables).

# Lectura de datos del bot. La genera: python -m tradebot.publish --crear-lector (también la escribe en .env.local).
DASHBOARD_DATABASE_URL=

# Panel de control (opcional). Sin estas tres variables el panel queda apagado y el dashboard es solo de lectura.
# La genera: python -m tradebot.publish --crear-operador. Solo puede crear órdenes pendientes y leer su estado.
DASHBOARD_OPERATOR_URL=
# Contraseña para entrar al panel. Larga: el dashboard es público.
CONTROL_PASSWORD=
# 32+ caracteres al azar. Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
CONTROL_SESSION_SECRET=
