# Llaves de Binance Demo Trading o de la testnet de Bybit, sin permiso de retiro. Nunca subas el archivo .env al repo.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Binance: usa SECRET (llave HMAC "System generated") o PRIVATE_KEY_PATH (llave Ed25519), no ambas.
# La llave privada Ed25519 va fuera del repo y fuera de carpetas sincronizadas (OneDrive, Dropbox).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_PRIVATE_KEY_PATH=

# Supabase > Connect > Session pooler (URI)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Claude en un servidor o en Docker: token de `claude setup-token` (en tu PC no hace falta).
CLAUDE_CODE_OAUTH_TOKEN=

# Docker: ruta en el servidor a la llave privada Ed25519 (se monta en el contenedor).
BINANCE_KEY_FILE=./secrets/id_ed25519

# Alertas por Telegram (opcional): token de @BotFather y tu chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard web: URL del usuario de solo lectura (la genera: python -m tradebot.publish --crear-lector).
DASHBOARD_DATABASE_URL=
