# Llaves de Binance Demo Trading o de la testnet de Bybit, sin permiso de retiro. Nunca subas el archivo .env al repo.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Binance: usa SECRET (llave HMAC "System generated") o PRIVATE_KEY_PATH (llave Ed25519), no ambas.
# La llave privada Ed25519 va fuera del repo y fuera de carpetas sincronizadas (OneDrive, Dropbox).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_PRIVATE_KEY_PATH=

# Supabase > Connect > Session pooler (URI)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
